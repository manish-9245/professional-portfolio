# MacOS
.DS_Store

# Python
__pycache__/
*.py[cod]

# Node/NPM
node_modules/

# Local editor/tooling config
.claude/
.vscode/
*.code-workspace

# Railway video-host deploy staging (mp4s live in each project's brag-output/)
video-host/*.mp4

# Ignore the heavy source images directly,
# so only the web-ready lightweight versions are tracked.
image/source/*.jpg
image/source/*.jpeg
image/source/*.png

# Generated blog artifacts - built on Vercel via npm run build, do not commit
posts/*.html
posts/index.json
sitemap.xml

# Except the original profile picture which is manually specified
!image/source/profile.jpg
